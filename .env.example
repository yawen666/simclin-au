# This file documents the server-side variables. The browser must never receive
# DEEPSEEK_API_KEY. For local development, copy server/.env.example to
# server/.env instead.
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
JWT_SECRET=replace-with-a-long-random-secret
PORT=4100
